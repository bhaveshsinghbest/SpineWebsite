# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
# Interface to listen on. Empty = all interfaces; 127.0.0.1 keeps the API private (set automatically on Render).
HOST=
# PostgreSQL connection. Leave empty in development to use the embedded PGlite database (PGLITE_DIR).
DATABASE_URL=postgres://spine_app:CHANGE_ME@localhost:5432/spine_advisory
DATABASE_SSL=false
# Embedded development database folder (used when DATABASE_URL is empty). Keep it out of synced folders
# such as OneDrive or Dropbox, which lock its files.
# PGLITE_DIR=./.data/pglite
# Public origin of the website (used for CORS, canonical URLs in the sitemap and links in emails).
PUBLIC_SITE_URL=http://localhost:4200
# Extra origins allowed to call the API directly (comma-separated). The Angular server proxies /api, so this is usually empty.
CORS_ORIGINS=
# Admin session: maximum lifetime in hours, and automatic sign-out after this many minutes without activity.
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=30
# Forgot Password: how long a reset link stays valid (minutes). Reset links are emailed, so set SMTP below in production.
PASSWORD_RESET_MINUTES=30
# Secret mixed into the anonymous daily visitor hash used for the dashboard's visitor statistics. Set a long random value.
VISITOR_HASH_SECRET=change-me-to-a-long-random-string
# Set true behind HTTPS so the session cookie is marked Secure (always true in production).
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (for correct client IPs in rate limiting).
TRUST_PROXY=1
# Email notifications for new enquiries and applications. Leave SMTP_HOST empty to log emails instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Spine Advisory Website <no-reply@spineadvisory.com>"
NOTIFY_ENQUIRIES_TO=info@spineadvisory.com
NOTIFY_APPLICATIONS_TO=info@spineadvisory.com
# Where uploaded files are stored (public images and private CVs).
UPLOAD_DIR=./uploads
LOG_LEVEL=info
